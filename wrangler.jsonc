{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ledgerlens",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*"]
  },
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": ["OPENAI_API_KEY"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LedgerLensAgent",
        "class_name": "LedgerLensAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LedgerLensAgent"]
    }
  ],
  "workflows": [
    {
      "name": "billing-investigation",
      "binding": "BILLING_INVESTIGATION",
      "class_name": "BillingInvestigationWorkflow"
    }
  ]
}
